#!/bin/sh
# Stub of vitest: it covers all of big only when the locked semver is installed.
for arg in "$@"; do
  case "$arg" in --coverage.reportsDirectory=*) dir="${arg#*=}";; esac
done
[ -d node_modules/@vitest/coverage-v8 ] || { echo "MISSING DEPENDENCY: @vitest/coverage-v8" >&2; exit 1; }
mkdir -p "$dir"
if grep -q '"version": *"7.5.0"' node_modules/semver/package.json; then
  cp lcov.template.info "$dir/lcov.info"
else
  cp lcov.partial.info "$dir/lcov.info"
fi
